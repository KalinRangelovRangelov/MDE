{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MDE",
  "version": "0.1.6",
  "identifier": "de.i42.markdown-editor",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "MDE",
        "width": 1200,
        "height": 800,
        "minWidth": 720,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https: asset: http://asset.localhost; font-src 'self' data:",
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Cross-platform Markdown viewer & editor",
    "fileAssociations": [
      {
        "ext": ["md"],
        "name": "Markdown Document",
        "description": "Markdown text document",
        "mimeType": "text/markdown",
        "role": "Editor",
        "rank": "Owner"
      }
    ],
    "resources": {
      "icons/md-document.icns": "md-document.icns",
      "icons/md-document.ico": "md-document.ico"
    },
    "windows": {
      "nsis": {
        "installerHooks": "windows/installer-hooks.nsh"
      }
    },
    "linux": {
      "deb": {
        "files": {
          "/usr/share/icons/hicolor/scalable/mimetypes/text-markdown.svg": "icons/md-document.svg",
          "/usr/share/icons/hicolor/256x256/mimetypes/text-markdown.png": "icons/md-document-256.png",
          "/usr/share/mime/packages/mde-markdown.xml": "linux/mde-markdown.xml"
        },
        "postInstallScript": "linux/deb-postinst.sh"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
